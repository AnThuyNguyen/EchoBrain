# Google AI Studio API key — get from https://aistudio.google.com/app/apikey
# Used for Gemma concept extraction and explanation analysis
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here

# Google Cloud API key — get from https://console.cloud.google.com/apis/credentials
# Requires the "Cloud Speech-to-Text API" to be enabled on your GCP project
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
