# Groq API key — used for concept extraction, STT transcription, and feedback analysis
GROQ_API_KEY=your_groq_api_key_here

# Optional: run without external AI calls
MOCK_MODE=false

# ElevenLabs TTS key — used for voice interaction feedback prompts
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional voice profile for ElevenLabs (defaults to Rachel if omitted)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
